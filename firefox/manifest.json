{
  "manifest_version": 3,
  "name": "Dynamic RTL",
  "version": "4.0.3",
  "description": "__MSG_extDescription__",
  "author": "soroush5",
  "homepage_url": "https://github.com/soroush5/Dynamic-RTL",
  "default_locale": "en",
  "icons": {
    "16": "icons/on-16.png",
    "32": "icons/on-32.png",
    "48": "icons/on-48.png",
    "128": "icons/on-128.png"
  },
  "action": {
    "default_title": "Dynamic RTL",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/on-16.png",
      "32": "icons/on-32.png",
      "48": "icons/on-48.png",
      "128": "icons/on-128.png"
    }
  },
  "background": {
    "scripts": [
      "lib/store.js",
      "background.js"
    ]
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus"
  ],
  "commands": {
    "toggle-site": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "__MSG_commandToggle__"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/assets.js",
        "content/main.js"
      ],
      "css": [
        "content/main.css"
      ],
      "run_at": "document_start"
    }
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "dynamic-rtl@soroush5",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
